{
  "name": "concurseiro-pro-max",
  "version": "1.0.0",
  "private": true,
  "description": "Preparação de 90 dias para concursos médicos (Medicina do Trabalho, Médico Legista e editais do Sul) + Radar de concursos médicos de PR, SC e RS.",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scrape": "tsx scripts/scrape-concursos-sul.ts",
    "scrape:dry": "tsx scripts/scrape-concursos-sul.ts --dry-run",
    "docs:plano": "tsx scripts/gerar-plano-md.ts",
    "edital": "tsx scripts/ler-edital.ts",
    "conteudo:validar": "tsx scripts/validar-conteudo.ts",
    "icons": "node scripts/generate-icons.mjs",
    "build:web": "expo export -p web && workbox generateSW workbox-config.cjs && node scripts/postbuild-web.mjs",
    "preview:web": "npx serve dist -s -l 4173",
    "doctor": "npx expo-doctor"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "cheerio": "^1.2.0",
    "railway": "^3.17.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "unpdf": "^2.2.1",
    "vitest": "^5.1.1",
    "workbox-cli": "^7.4.1"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.5.2",
    "date-fns": "^4.4.0",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "lucide-react-native": "^1.75.0",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^3.4.19",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "main": "expo-router/entry",
  "engines": {
    "node": ">=20"
  }
}
