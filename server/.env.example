# Copie para server/.env para rodar localmente (npm run dev). Nunca versione o .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/concurseiro
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
API_URL=http://localhost:3000
WEB_URL=http://localhost:8081
# Opcional: origens extras (vírgula), ex.: um site de testes
ORIGENS_EXTRAS=
# Opcional: login com Google (cliente OAuth "Aplicativo da Web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: e-mails reais (sem chave, os e-mails aparecem no log)
RESEND_API_KEY=
EMAIL_FROM=Concurseiro Pro Max <nao-responda@concurseiro.zezasultratools.uk>
