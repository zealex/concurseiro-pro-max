{
  "name": "concurseiro-api",
  "version": "1.0.0",
  "private": true,
  "description": "API do Concurseiro Pro Max: contas (Better Auth) e sincronização do progresso (Postgres).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.28",
    "@hono/node-server": "^2.1.11",
    "better-auth": "^1.7.28",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.22",
    "jose": "^6.2.18",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@types/node": "^26.6.7",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
